# 无硬件压测专用配置
# 运行环境: development | production
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# 使用模拟数据模式，避免连接硬件
DATA_SOURCE=mock
ENABLE_DASHBOARD_MOCK=true
ENABLE_ZMQ_DASHBOARD_LISTENER=false
ENABLE_ZMQ_BROKER_MANAGER=false
ENABLE_SIGNAL_ZMQ_ADAPTER=false
ENABLE_VEHICLE_PROCESS_MANAGER=false

# UDP 配置（本地回环）
UDP_HOST=127.0.0.1
UDP_PORT=9000

# PLC 司机台 TCP 地址（设置为本地回环，避免连接超时）
PLC_HOST=127.0.0.1
PLC_PORT=8001

# 信号屏 TCP 地址（设置为本地回环）
SIGNAL_MMI_HOST=127.0.0.1
SIGNAL_MMI_PORT=9999

# 视景系统 UDP 目标地址（设置为本地回环）
SCENERY_HOST=127.0.0.1
SCENERY_PORT=8303
SCENERY_LOCAL_PORT=8302

# ZMQ Broker 地址（本地回环）
ZMQ_BROKER_FRONTEND=tcp://127.0.0.1:5555
ZMQ_BROKER_BACKEND=tcp://127.0.0.1:5556
ZMQ_ADDRESS=tcp://127.0.0.1:5555

# 3D viewer mapping
VISUAL_TRACK=0
VISUAL_DIRECTION_NAME=down
SIGNAL_COORD_OFFSET_M=216.46
VIEWER_ABS_OFFSET_M=4028.28

# CORS配置
CORS_ORIGINS=["http://localhost:5173"]