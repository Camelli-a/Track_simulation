# Runtime: development | production
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# 数据源模式: mock | tcp | zmq
DATA_SOURCE=mock

# UDP 配置（兼容保留）
UDP_HOST=0.0.0.0
UDP_PORT=9000

# PLC 司机台 TCP 连接配置（DATA_SOURCE=tcp 时生效）
PLC_HOST=192.168.100.123
PLC_PORT=8001

# 向司机台发送数据（上行，格式待定）
# DRIVER_CONSOLE_SEND_PORT=9001

# ZMQ Broker 地址
ZMQ_BROKER_FRONTEND=tcp://127.0.0.1:5555
ZMQ_BROKER_BACKEND=tcp://127.0.0.1:5556

# Legacy compatible address used by older code paths.
ZMQ_ADDRESS=tcp://127.0.0.1:5555
