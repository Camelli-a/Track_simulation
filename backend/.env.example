# 运行环境: development | production
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# 数据源模式
# mock: 纯前端演示，不启动仿真循环，不连 PLC
# zmq:  启动 Train 仿真 + ATO + PLC TCP（PLC 不在线时自动重连，不报错）
DATA_SOURCE=zmq

# UDP 配置（兼容保留）
UDP_HOST=0.0.0.0
UDP_PORT=9000

# PLC 司机台 TCP 地址（zmq 模式下始终尝试连接）
PLC_HOST=192.168.100.123
PLC_PORT=8001

# ZMQ Broker 地址
ZMQ_BROKER_FRONTEND=tcp://127.0.0.1:5555
ZMQ_BROKER_BACKEND=tcp://127.0.0.1:5556
ZMQ_ADDRESS=tcp://127.0.0.1:5555
