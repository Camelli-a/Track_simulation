# Runtime: development | production
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Data source: mock | udp | zmq
DATA_SOURCE=mock

# UDP
UDP_HOST=0.0.0.0
UDP_PORT=9000

# ZMQ broker addresses.
# Subscribers connect to FRONTEND, publishers connect to BACKEND.
ZMQ_BROKER_FRONTEND=tcp://127.0.0.1:5555
ZMQ_BROKER_BACKEND=tcp://127.0.0.1:5556

# Legacy compatible address used by older code paths.
ZMQ_ADDRESS=tcp://127.0.0.1:5555
